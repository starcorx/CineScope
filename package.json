{
  "name": "cinescope",
  "version": "1.0.0",
  "description": "Plataforma Full-Stack de Descubrimiento Cinematográfico con API REST, MVC, SQLite, Bootstrap 5 y Sass",
  "main": "src/server.js",
  "scripts": {
    "build:css": "sass src/scss/main.scss public/css/main.css --no-source-map --silence-deprecation=import,global-builtin,color-functions,if-function",
    "watch:css": "sass --watch src/scss/main.scss:public/css/main.css --silence-deprecation=import,global-builtin,color-functions,if-function",
    "start": "node src/server.js",
    "dev:server": "nodemon src/server.js",
    "dev": "npm-run-all --parallel watch:css dev:server"
  },
  "keywords": [
    "cinescope",
    "tmdb",
    "movies",
    "full-stack",
    "express",
    "sqlite",
    "bootstrap",
    "sass",
    "mvc"
  ],
  "author": "CineScope Team",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "sass": "^1.83.4"
  }
}
