# ===============================================
# CINESCOPE - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# ===============================================

# Puerto en el que se ejecuta el servidor Node.js / Express
PORT=3000

# Clave de API de The Movie Database (TMDB v3 API Key)
# Obtenla registrándote gratis en https://www.themoviedb.org/settings/api
TMDB_API_KEY=tu_api_key_de_tmdb_aqui

# URL base oficial de la API de TMDB
TMDB_BASE_URL=https://api.themoviedb.org/3

# URL base para cargar imágenes y pósteres de TMDB
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
